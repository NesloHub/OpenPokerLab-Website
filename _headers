# Security and caching headers for Cloudflare Pages.
# Everything after a path pattern is sent with the response for that pattern.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'
  Strict-Transport-Security: max-age=31536000

# Fonts and avatars never change without a new file name, so they can live in the browser cache.
/fonts/*
  Cache-Control: public, max-age=604800

/avatars/*
  Cache-Control: public, max-age=604800

/pokernotes-v21.webp
  Cache-Control: public, max-age=604800

/poker-equity-lab.webp
  Cache-Control: public, max-age=604800

/pokerrng.webp
  Cache-Control: public, max-age=604800

/pokervision-v21.webp
  Cache-Control: public, max-age=604800

/logo.png
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800

/fonts.css
  Cache-Control: public, max-age=604800
